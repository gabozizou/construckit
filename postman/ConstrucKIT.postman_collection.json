{
  "info": {
    "name": "ConstrucKIT API",
    "description": "API de equipos, cargas de combustible y mantenciones (prueba técnica Loki Labs).\n\nUso:\n1. Ejecuta **Auth > Login** (usuario del seeder: demo@construckit.cl / password). El token se guarda solo en la variable `token`.\n2. Las demás peticiones usan ese token automáticamente (autenticación Bearer a nivel de colección).\n\n`equipment_id` = 1 apunta a CAM-101 del seeder. `new_equipment_id` se llena al ejecutar **Equipos > Crear equipo**.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "equipment_id",
      "value": "1"
    },
    {
      "key": "new_equipment_id",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "login"
              ]
            },
            "description": "Entrega un token Sanctum. El script de Tests lo guarda en la variable `token`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@construckit.cl\",\n  \"password\": \"password\",\n  \"device_name\": \"postman\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.collectionVariables.set('token', pm.response.json().token);",
                  "}",
                  "pm.test('Login correcto (200)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Usuario actual",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/user",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "user"
              ]
            },
            "description": "Devuelve el usuario dueño del token."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "logout"
              ]
            },
            "description": "Revoca el token actual. Después de esto hay que volver a hacer login."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Token revocado (204)', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sin token (401)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/equipment",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "equipment"
              ]
            },
            "description": "Ejemplo de error: sin token la API responde 401.",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Rechaza sin token (401)', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Equipos",
      "item": [
        {
          "name": "Listar equipos",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/equipment?",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "equipment"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "operativo",
                  "disabled": true,
                  "description": "Filtro opcional: operativo, en_mantencion, fuera_de_servicio"
                },
                {
                  "key": "type",
                  "value": "camion",
                  "disabled": true,
                  "description": "Filtro opcional por tipo"
                },
                {
                  "key": "page",
                  "value": "1",
                  "disabled": true
                }
              ]
            },
            "description": "Lista paginada (15 por página). Filtros opcionales ?status= y ?type=."
          }
        },
        {
          "name": "Crear equipo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/equipment",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "equipment"
              ]
            },
            "description": "Crea un equipo (201). El script guarda su id en `new_equipment_id`. Si lo ejecutas dos veces, el código duplicado devuelve 422.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"CAM-102\",\n  \"type\": \"camion\",\n  \"plate\": \"LKJH45\",\n  \"brand\": \"Scania\",\n  \"model\": \"R450\",\n  \"current_hourmeter\": 500\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('new_equipment_id', pm.response.json().data.id);",
                  "}",
                  "pm.test('Equipo creado (201)', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver equipo",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/equipment/{{new_equipment_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "equipment",
                "{{new_equipment_id}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Editar estado",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/equipment/{{new_equipment_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "equipment",
                "{{new_equipment_id}}"
              ]
            },
            "description": "Edición parcial: se envían solo los campos que cambian.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"en_mantencion\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Editar horómetro (422)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/equipment/{{new_equipment_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "equipment",
                "{{new_equipment_id}}"
              ]
            },
            "description": "Ejemplo de error: el horómetro no se edita directamente, lo actualizan las cargas y mantenciones.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"current_hourmeter\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Crear con datos inválidos (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/equipment",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "equipment"
              ]
            },
            "description": "Ejemplo de error de validación con mensajes en español.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"X\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Eliminar equipo",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/equipment/{{new_equipment_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "equipment",
                "{{new_equipment_id}}"
              ]
            },
            "description": "Soft delete (204): el equipo deja de aparecer, pero su historial se conserva."
          }
        },
        {
          "name": "Equipos que necesitan mantención preventiva",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/equipment/maintenance-due",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "equipment",
                "maintenance-due"
              ]
            },
            "description": "Equipos con más de 250 h desde su última preventiva (o desde 0 si nunca tuvieron), del más urgente al menos urgente."
          }
        }
      ]
    },
